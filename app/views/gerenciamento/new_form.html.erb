<div class="container">
  <div class="sidebar">
    <h3>Sidebar</h3>
    <ul>
      <li><a href="<%= url_for(controller: 'avaliacoes', action: 'index') %>">Avaliações</a></li>
      <li><a href="<%= url_for(controller: 'gerenciamento', action: 'index') %>">Gerenciamento</a></li>
    </ul>
  </div>

  <div class="main-content">
    <h1>Criação de Formulário</h1>
    
    <% if @questionario&.errors&.any? %>
      <div class="error-messages">
        <ul>
          <% @questionario.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: @questionario, url: create_form_gerenciamento_index_path, method: :post do |f| %>
      <div>
        <%= f.label :nome, "Nome" %>
        <%= f.text_field :nome, required: true, 
            oninvalid: "this.setCustomValidity('Por favor, preencha o nome do formulário')",
            oninput: "this.setCustomValidity('')" %>
      </div>
      <div>
        <%= f.label :turma_id, "Turma" %>
        <%= f.select :turma_id, 
            options_from_collection_for_select(@turmas, :id, :codigo),
            required: true,
            prompt: "Selecione uma turma" %>
      </div>
      <div>
        <%= f.label :template_id, "Template Base" %>
        <%= f.select :template_id, 
            options_from_collection_for_select(@templates, :id, :nome),
            required: true,
            prompt: "Selecione um template" %>
      </div>
      <div>
        <%= f.submit "Criar Formulário" %>
      </div>
    <% end %>
  </div>
</div>

<style>
.error-messages {
  color: #dc3545;
  background-color: #f8d7da;
  border: 1px solid #f5c6cb;
  border-radius: 4px;
  padding: 10px;
  margin-bottom: 20px;
}

.error-messages ul {
  margin: 0;
  padding-left: 20px;
}

select:invalid {
  color: gray;
}
</style>
