<div class="container mt-5">
  <h2>Login</h2>
  
  <%= form_with url: login_path, method: :post, local: true do |form| %>
    <div class="form-group">
      <%= form.label :identifier, "Email ou Matrícula" %>
      <%= form.text_field :identifier, class: "form-control", placeholder: "Digite seu email ou matrícula" %>
    </div>
    
    <div class="form-group">
      <%= form.label :password, "Senha" %>
      <%= form.password_field :password, class: "form-control", placeholder: "Digite sua senha" %>
    </div>
    
    <div class="form-group mt-3">
      <%= form.submit "Entrar", class: "btn btn-primary" %>
    </div>
  <% end %>
</div>